# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (PostgreSQL). A free Neon project works: https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Login sessions: any long random string (e.g. run: openssl rand -base64 32)
SESSION_SECRET=""

# --- The shop: where it is, and the owner who can log in at /admin/login
SHOP_LAT=""
SHOP_LNG=""
ADMIN_PHONE=""            # owner's 10-digit mobile number

# --- Shown in the website footer (leave blank to hide)
SHOP_PHONE=""             # country code + number, no + or spaces, e.g. 919876543210
SHOP_ADDRESS=""
FSSAI_NO=""

# --- UPI payments: customers pay to this UPI ID. Orders stay closed until it is set.
SHOP_UPI_ID=""            # e.g. yourshop@okhdfcbank
SHOP_UPI_NAME="Mangalore Stores"

# --- Password-reset emails (any SMTP account, e.g. Gmail with an App Password)
APP_URL=""                # your website address, e.g. https://yourshop.com
SMTP_HOST=""              # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
